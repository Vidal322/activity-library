# Address the HTTP server listens on.
ADDR=":8080"

# PostgreSQL connection string.
# Required: the API exits with status 1 if this is not set.
DB_DSN="postgres://user:password@localhost:5432/activity_library?sslmode=disable"

# Connection pool sizing. 
#
# MAX_CONNS is a ceiling *per API instance*, so it has to be coordinated with
# the server's max_connections (Postgres defaults to 100). 
DB_MAX_CONNS="25"

# Connections kept warm to avoid a cold start on the first request. 
DB_MIN_CONNS="5"

# ---- docker-compose ----
# The Makefile passes this file to Compose via --env-file, so the variables
# below and the DB_DSN above live in one place. Nothing enforces that they
# agree: if changed POSTGRES_PW, POSTGRES_USER or POSTGRES_DB, update the
# matching field in DB_DSN too, or the API will fail to authenticate.
POSTGRES_USER="user"
POSTGRES_PW="password"
POSTGRES_DB="activity_library"

# pgAdmin sign-in, served on http://localhost:5050.
PGADMIN_MAIL="dev@example.com"
PGADMIN_PW="changeit"
