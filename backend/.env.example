# Address the HTTP server listens on.
ADDR=":8080"

# PostgreSQL connection string.
# Required: the API exits with status 1 if this is not set.
DB_DSN="postgres://user:password@localhost:5432/activity_library?sslmode=disable"

# Connection pool sizing. 
#
# MAX_CONNS is a ceiling *per API instance*, so it has to be coordinated with
# the server's max_connections (Postgres defaults to 100). 
DB_MAX_CONNS="25"

# Connections kept warm to avoid a cold start on the first request.
DB_MIN_CONNS="5"

# ---- sessions ----
# How long a login lasts. Parsed as a time.Duration, so it is written with a
# unit ("720h", "30m") and never as a bare number of seconds.
#
# The value is read twice on every login: it sets the cookie's Max-Age and the
# expires_at column of the sessions row. Those are two independent clocks, and
# nothing makes them agree, which is why the duration lives here once rather
# than as a literal in each place.
SESSION_TTL="720h"

# Whether the session cookie carries the Secure attribute, which tells the
# browser to send it over HTTPS only.
#
# It defaults to true in code, so forgetting this variable in production fails
# closed rather than shipping sessions in cleartext. Development runs over plain
# http and therefore sets it to false below.
#
# A browser that enforces this rejects the Set-Cookie outright: nothing is
# stored, login still answers 200, and every request after it is a 401 with no
# error logged anywhere. Chrome and Firefox make an exception for localhost, so
# the mistake can hide on a laptop and only surface once the API is reached at a
# container name or a LAN address.
SESSION_COOKIE_SECURE="false"

# ---- tests ----
# The database-backed tests read DB_TEST_DSN, which is intentionally NOT a
# variable of this file: godotenv loads .env at startup, and the harness
# truncates every table it finds, so it must never be able to reach the
# development database by accident. It has no fallback to DB_DSN either.
#
# Export it in the shell instead. `make db-test-create` creates the database and
# prints the line to export; the harness refuses any name not ending in _test,
# and the tests skip themselves when the variable is unset.
#
#   export DB_TEST_DSN="postgres://user:password@localhost:5432/activity_library_test?sslmode=disable"

# ---- docker-compose ----
# The Makefile passes this file to Compose via --env-file, so the variables
# below and the DB_DSN above live in one place. Nothing enforces that they
# agree: if changed POSTGRES_PW, POSTGRES_USER or POSTGRES_DB, update the
# matching field in DB_DSN too, or the API will fail to authenticate.
POSTGRES_USER="user"
POSTGRES_PW="password"
POSTGRES_DB="activity_library"

# pgAdmin sign-in, served on http://localhost:5050.
PGADMIN_MAIL="dev@example.com"
PGADMIN_PW="changeit"
